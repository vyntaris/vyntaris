{
  "manifest_version": 2,
  "name": "Vyntaris Passwords",
  "version": "1.0.1",
  "description": "Logins saved and filled by the Vyntaris island, kept by pass on this computer.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "passwords@vyntaris.com",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
