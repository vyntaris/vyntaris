[Unit]
Description=Keep the login screen's wallpaper, theme and picture in step with %i's desktop

[Path]
PathChanged=/home/%i/.config/quickshell/settings.json
PathChanged=/home/%i/.face
PathChanged=/home/%i/.cache/vyntaris/accent-wallpaper/current.jpg
Unit=vyntaris-greeter-sync@%i.service

[Install]
WantedBy=multi-user.target
