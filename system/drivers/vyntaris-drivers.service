[Unit]
Description=Drivers for the hardware found
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/vyntaris/drivers --install --auto
Nice=10
IOSchedulingClass=idle
# Shutdown waits for pacman and the boot image instead of killing them halfway
KillSignal=SIGCONT
TimeoutStopSec=5min
