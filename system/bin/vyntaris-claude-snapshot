#!/usr/bin/env bash
# A Timeshift snapshot before a Claude Code session changes the system (scripts/claude-hook.py, through pkexec).
#   vyntaris-claude-snapshot <folder> <command>
set -uo pipefail
[ "$(id -u)" -eq 0 ] || { echo "run this through pkexec" >&2; exit 1; }
command -v timeshift >/dev/null || exit 0
where="$(printf %s "${1:-}" | tr -cd '[:alnum:] ._/~-' | cut -c1-60)"
what="$(printf %s "${2:-}" | tr -cd '[:alnum:] ._/=:-' | cut -c1-60)"
timeshift --create --scripted --comments "claude: ${what:-$where}" --tags O >/dev/null 2>&1 || exit 1
# the last three of these are kept
timeshift --list --scripted 2>/dev/null | awk '/ claude: / {print $3}' | head -n -3 |
    xargs -r -n1 timeshift --delete --scripted --snapshot >/dev/null
/usr/lib/vyntaris/snapshots
