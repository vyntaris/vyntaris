#!/usr/bin/env python3
import os
import pty
import select
import signal
import sys

lines = sys.stdin.read().split("\n")
if len(lines) < 2 or not lines[0] or not lines[1]:
    sys.exit("the current password and the new one, a line each")
answers = [lines[0], lines[1], lines[1]]

pid, fd = pty.fork()
if pid == 0:
    os.environ["LC_ALL"] = "C"
    os.execvp("passwd", ["passwd"])

said = b""
heard = b""
while True:
    ready, _, _ = select.select([fd], [], [], 30)
    if not ready:
        os.kill(pid, signal.SIGKILL)
        break
    try:
        chunk = os.read(fd, 1024)
    except OSError:
        break
    if not chunk:
        break
    heard += chunk
    said += chunk
    if heard.rstrip().lower().endswith(b"password:"):
        if not answers:
            os.kill(pid, signal.SIGKILL)
            break
        os.write(fd, (answers.pop(0) + "\n").encode())
        heard = b""

code = os.waitstatus_to_exitcode(os.waitpid(pid, 0)[1])
if code:
    last = [line for line in said.decode(errors="replace").splitlines() if line.strip()]
    print(last[-1].strip() if last else "passwd failed", file=sys.stderr)
sys.exit(1 if code else 0)
