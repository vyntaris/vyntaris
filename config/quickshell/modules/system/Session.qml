import Quickshell
import Quickshell.Io
import QtQuick
import qs.config
import qs.services

Scope {
    id: root

    readonly property bool nightLight: NightLight.active
    readonly property var displays: Displays.waiting
    readonly property var rollback: UpdateGuard.rollback
    readonly property var drivers: Drivers.missing

    BatteryWatch {}

    Component.onCompleted: {
        if (!Config.theme.sounds || Config.theme.loginSound === "off") return;
        Quickshell.execDetached(["sh", "-c",
            'f="$XDG_RUNTIME_DIR/shell-login-sound"; [ -e "$f" ] && exit 0; touch "$f"; pw-play "$1"',
            "sh", Config.loginSoundPath(Config.theme.loginSound)]);
    }

    Process {
        running: true
        command: ["sh", "-c", 'f="${XDG_RUNTIME_DIR:-/tmp}/shell-startup-apps"; [ -e "$f" ] && exit 1; touch "$f"']
        onExited: code => { if (code === 0) startupLater.start(); }
    }
    Timer { id: startupLater; interval: 2500; onTriggered: root.runStartupApps() }
    function runStartupApps() {
        for (const a of Config.startup.apps ?? []) {
            if (a.command) { Config.launch(["sh", "-c", a.command]); continue; }
            const e = DesktopEntries.byId(a.id);
            if (!e) continue;
            if (e.runInTerminal) Config.runInTerminal(e.command.join(" "));
            else if (!Games.launch(e)) Config.openEntry(e);
        }
    }

    readonly property string configHome:
        Quickshell.env("XDG_CONFIG_HOME") || Quickshell.env("HOME") + "/.config"

    readonly property string idleSignature: [
        Config.idle.dimAfter, Config.idle.lockAfter, Config.idle.screenOffAfter, Config.idle.suspendAfter,
    ].join("|")
    onIdleSignatureChanged: idleDebounce.restart()

    Timer {
        id: idleDebounce
        interval: 500
        running: true
        onTriggered: root.applyIdle()
    }

    function listener(timeout, onTimeout, onResume) {
        if (!(timeout > 0)) return "";
        return `\nlistener {\n    timeout = ${timeout}\n    on-timeout = ${onTimeout}\n`
            + (onResume ? `    on-resume = ${onResume}\n` : "") + "}\n";
    }

    function applyIdle() {
        const dpms = state => `hyprctl dispatch 'hl.dsp.dpms({ action = "${state}" })'`;
        const conf = "# generated by quickshell from settings.json (idle). Edits are overwritten.\n\n"
            + "general {\n"
            + "    lock_cmd = qs -c vyntaris ipc call lock lock\n"
            + "    before_sleep_cmd = loginctl lock-session\n"
            + `    after_sleep_cmd = ${dpms("on")}\n`
            + "}\n"
            + listener(Config.idle.dimAfter, "qs -c vyntaris ipc call brightness dim", "qs -c vyntaris ipc call brightness restore")
            + listener(Config.idle.lockAfter, "loginctl lock-session")
            + listener(Config.idle.screenOffAfter, dpms("off"), dpms("on"))
            + listener(Config.idle.suspendAfter, "systemctl suspend");

        Quickshell.execDetached(["sh", "-c",
            'mkdir -p "$(dirname "$1")" && printf "%s" "$2" > "$1"; '
            + 'command -v hypridle >/dev/null || exit 0; '
            + 'if systemctl --user is-enabled -q hypridle.service 2>/dev/null; then '
            + 'systemctl --user reset-failed hypridle.service; systemctl --user restart hypridle.service; '
            + 'else pkill -x hypridle; sleep 0.2; setsid -f hypridle >/dev/null 2>&1; fi',
            "sh", configHome + "/hypr/hypridle.conf", conf]);
    }
}
