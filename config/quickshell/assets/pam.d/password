# The lock screen. After 5 wrong passwords it waits 2 minutes (pam_faillock, the tally sudo and the login share);
# the right one clears the count.
auth     required                 pam_faillock.so preauth deny=5 unlock_time=120
auth     [success=1 default=bad]  pam_unix.so
auth     [default=die]            pam_faillock.so authfail deny=5 unlock_time=120
auth     optional                 pam_faillock.so authsucc deny=5 unlock_time=120
account  required                 pam_unix.so
